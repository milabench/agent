# Milabench Agent Configuration File
# This file can be sourced by scripts to load configuration

# Installation directories
MILABENCH_BASE={{ milabench_base }}
AGENT_INSTALL_DIR={{ agent_install_dir }}
AGENT_JOB_DIR={{ agent_job_dir }}
AGENT_LOG_DIR={{ agent_log_dir }}

# Service configuration
AGENT_USER={{ agent_user }}
AGENT_GROUP={{ agent_group }}
AGENT_SERVICE_NAME={{ agent_service_name }}

# Server configuration
AGENT_SERVER_HOST={{ agent_server_host }}
AGENT_SERVER_PORT={{ agent_server_port }}
AGENT_SERVER_WORKERS={{ agent_server_workers }}

# Logging
AGENT_LOG_LEVEL={{ agent_log_level }}

# Repository
AGENT_REPO_URL={{ agent_repo_url }}
AGENT_REPO_BRANCH={{ agent_repo_branch }}

# Python environment
VENV_PATH={{ agent_install_dir }}/.venv
